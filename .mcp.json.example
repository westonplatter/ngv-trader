{
  "mcpServers": {
    "ngv-semantic": {
      "command": "uv",
      "args": ["run", "--extra", "mcp", "python", "-m", "src.mcp.semantic_server"],
      "cwd": "/absolute/path/to/ngv-trader",
      "env": {
        "NGV_SEMANTIC_DATABASE_URL": "postgresql://ngv_analyst:CHANGE_ME@host:5432/ngtrader_prod"
      }
    }
  }
}
